{
  "name": "greeninstallatienoord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck:api": "tsc -p worker/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply greeninstallatie --local",
    "db:migrate:remote": "wrangler d1 migrations apply greeninstallatie --remote",
    "hash-admin-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
